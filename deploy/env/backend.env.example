# Custodium backend environment (S1 + S2). Copy to
# /srv/custodium/.env, chmod 600, replace every <...> value.
# Secrets come from your KMS/Vault in real deployments — this
# file is the inventory of what must exist, not a secret store.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=<50+ random characters>
DJANGO_ALLOWED_HOSTS=api.example.com,app.example.com
DATABASE_URL=<redacted>
REDIS_URL=redis://:<redis-password>@<S3-private-ip>:6379/0
WAAS_SECRET_ENCRYPTION_KEY=<Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">
LOG_LEVEL=INFO

# --- MPC signer gate -------------------------------------------------
# Leave BOTH unset (disabled) until the independent cryptographic
# review has passed AND the written production approval exists.
# Enabling signing is a gated operator decision, not an install step.
# MPC_SIGNER_ENABLED=true
# MPC_SIGNER_URL=http://<coordinator-node-private-ip>:8401
# MPC_SIGNER_TOKEN=<redacted>
# MPC_SIGNER_THRESHOLD=2

# --- Chain RPC endpoints --------------------------------------------
# Configured in the settings overlay (see
# docs/operations/installation-production.md, "RPC overlay"):
# EVM_RPC_ENDPOINTS, TRON_API_ENDPOINTS (+TRON_API_KEY),
# SOLANA_RPC_ENDPOINTS, TON_API_ENDPOINTS (+TON_API_KEY) —
# at least two providers per network, per network slug.
