# One signer node (copy to /etc/custodium/signer.env, chmod 600,
# owned by the custodium-signer user). Every node in the cluster
# shares SIGNER_PEERS / SIGNER_CLUSTER_TOKEN / SIGNER_API_TOKEN;
# SIGNER_PARTY_INDEX, SIGNER_BIND, the store dir and the store
# KEY FILE are unique per node — the key file especially must
# never be copied to another node.
SIGNER_PARTY_INDEX=0
SIGNER_PEERS=http://<s4-private-ip>:8401,http://<s5-private-ip>:8401,http://<s6-private-ip>:8401
SIGNER_BIND=0.0.0.0:8401
SIGNER_STORE_DIR=/var/lib/custodium-signer/store
SIGNER_STORE_KEY_FILE=/etc/custodium/store.key
SIGNER_API_TOKEN=<redacted>
SIGNER_CLUSTER_TOKEN=<redacted>
