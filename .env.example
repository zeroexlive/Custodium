# Copy to .env for local development. Never commit real secrets.
DJANGO_SECRET_KEY=dev-only-insecure-secret-key-change-me
DJANGO_ALLOWED_HOSTS=*
DJANGO_SETTINGS_MODULE=config.settings.development

# Leave empty for SQLite locally; Compose sets a Postgres URL for its backend.
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0

# Required in production: Fernet key for encrypting recoverable API secrets.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# In production this must be KMS/Vault-managed, never a repo or image value.
WAAS_SECRET_ENCRYPTION_KEY=

POSTGRES_DB=custodium
POSTGRES_USER=custodium
POSTGRES_PASSWORD=custodium-dev-password
